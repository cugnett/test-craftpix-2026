var platform_times = level_info.get("platform_times")
var platform_times_arr = str_to_var(platform_times)
var idx = 0

var platform_output_array = []

signal key_jump1_press()
signal key_jump3_press()

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$Conductor.play_with_beat_offset(4)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Input.is_action_just_pressed("jump_1"):
		emit_signal("key_jump1_press")
	if Input.is_action_just_pressed("jump_3"):
		emit_signal("key_jump3_press")
	


func _spawn_platform() -> void:
	
	instance = platform.instantiate()
	instance.position = Vector2(500,300)
	instance.scaleWidth = 1
	add_child(instance)

func _on_conductor_b_beat(position: Variant) -> void:
	beatCount = position
	$BeatCount.text = str(beatCount)
	if idx < platform_times_arr.size():
		if beatCount >= platform_times_arr[idx]:
			idx += 1
			_spawn_platform()
	


func _on_key_jump_1_press() -> void:
	print(str(beatCount))
	platform_output_array.append(beatCount)


func _on_key_jump_3_press() -> void:
	print(str(platform_output_array))
